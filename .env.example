TZ=Asia/Hong_Kong
ONECLI_URL=http://127.0.0.1:10254
ONECLI_API_KEY=oc_YOUR_ONECLI_API_KEY

# Telegram channel
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# 3rd-party Claude hosting (proxy endpoint)
# ANTHROPIC_BASE_URL=https://api.aiohub.org
# ANTHROPIC_AUTH_TOKEN=sk-YOUR_AUTH_TOKEN

# Model override for Claude Code inside container
CLAUDE_CODE_USE_MODEL=claude-opus-4-6

# Container timeouts
IDLE_TIMEOUT=7200000
CONTAINER_TIMEOUT=7200000

# Port forwards (comma-separated host:container pairs)
# NANOCLAW_PORT_FORWARDS=1330:1330,1337:1337,3000:3000,3008:3008,5433:5433,3200:3200

# Playwright browser URL (host-headed browser for UI testing)
# NANOCLAW_PLAYWRIGHT_URL=http://host.docker.internal:3100/mcp
